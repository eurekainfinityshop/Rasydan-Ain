/* ===========================================
   WALIMATUL URUS
   Nurul Ain & Abdul Rasydan
   Theme : Sage Green + Gold + White
=========================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{

    font-family:'Poppins',sans-serif;

    background:#f8f7f2;

    color:#444;

    overflow-x:hidden;

    line-height:1.7;

}

/* Scroll */

::-webkit-scrollbar{

width:8px;

}

::-webkit-scrollbar-thumb{

background:#7c9775;

border-radius:20px;

}

/* ============================
INTRO
============================ */

#intro{

position:fixed;

top:0;

left:0;

width:100%;

height:100vh;

display:flex;

justify-content:center;

align-items:center;

background:
linear-gradient(rgba(255,255,255,.45),
rgba(255,255,255,.45)),
url("images/background.jpg");

background-size:cover;

background-position:center;

z-index:9999;

transition:1s;

}

.overlay{

background:rgba(255,255,255,.82);

backdrop-filter:blur(12px);

padding:45px;

border-radius:25px;

text-align:center;

width:90%;

max-width:450px;

box-shadow:0 15px 35px rgba(0,0,0,.15);

}

.subtitle{

letter-spacing:5px;

color:#688462;

font-size:15px;

margin-bottom:15px;

text-transform:uppercase;

}

.overlay h1{

font-family:'Cinzel',serif;

font-size:45px;

color:#b58b2d;

line-height:1.4;

}

.overlay span{

display:block;

font-size:30px;

margin:8px 0;

color:#5d775f;

}

.overlay p{

margin-top:18px;

font-size:17px;

}

#open{

margin-top:35px;

padding:16px 38px;

border:none;

border-radius:50px;

background:#688462;

color:white;

cursor:pointer;

font-size:17px;

font-weight:600;

transition:.3s;

}

#open:hover{

transform:translateY(-3px);

background:#53714f;

box-shadow:0 8px 20px rgba(0,0,0,.15);

}

/* ============================
CONTENT
============================ */

#content{

display:none;

animation:fadePage 1s;

}

@keyframes fadePage{

from{

opacity:0;

transform:translateY(20px);

}

to{

opacity:1;

transform:translateY(0);

}

}

/* ============================
HERO
============================ */

.hero{

padding:90px 20px;

text-align:center;

background:white;

}

.hero h2{

font-size:28px;

color:#55745d;

margin-bottom:25px;

}

.hero h1{

font-family:'Cinzel',serif;

font-size:44px;

color:#b58b2d;

line-height:1.6;

}

.hero h1 span{

color:#688462;

}

.hero p{

margin-top:25px;

font-size:18px;

max-width:700px;

margin-left:auto;

margin-right:auto;

}

/* ============================
SECTION
============================ */

section{

padding:70px 20px;

text-align:center;

}

section h2{

font-family:'Cinzel',serif;

font-size:34px;

color:#5d775f;

margin-bottom:35px;

}

/* ============================
COUNTDOWN
============================ */

#countdown{

display:flex;

justify-content:center;

gap:20px;

flex-wrap:wrap;

margin-top:30px;

}

#countdown div{

width:100px;

background:white;

padding:22px;

border-radius:18px;

box-shadow:0 10px 25px rgba(0,0,0,.08);

transition:.3s;

}

#countdown div:hover{

transform:translateY(-5px);

}

#countdown span{

display:block;

font-size:34px;

font-weight:bold;

color:#b58b2d;

}

#countdown p{

margin-top:8px;

font-size:15px;

color:#666;

}

/* ============================
CARD
============================ */

.card{

max-width:550px;

margin:18px auto;

padding:25px;

background:white;

border-radius:20px;

box-shadow:0 10px 25px rgba(0,0,0,.08);

transition:.3s;

}

.card:hover{

transform:translateY(-5px);

}

.card i{

font-size:32px;

margin-bottom:15px;

color:#688462;

}

.card p{

font-size:17px;

line-height:1.8;

}

/* ============================
BUTTON
============================ */

.buttonGroup{

display:flex;

justify-content:center;

flex-wrap:wrap;

gap:18px;

margin-top:30px;

}

.btn{

display:inline-flex;

align-items:center;

gap:10px;

padding:15px 28px;

background:#688462;

color:white;

text-decoration:none;

border-radius:50px;

font-weight:600;

transition:.3s;

}

.btn:hover{

background:#53714f;

transform:translateY(-3px);

}

.btn i{

font-size:20px;

}

/* ============================
QR DUITNOW
============================ */

.qr{

width:260px;

max-width:90%;

border-radius:18px;

box-shadow:0 10px 30px rgba(0,0,0,.12);

margin-top:20px;

cursor:pointer;

transition:.3s;

}

.qr:hover{

transform:scale(1.04);

}

/* ============================
POPUP QR
============================ */

#giftPopup{

display:none;

position:fixed;

top:0;

left:0;

width:100%;

height:100%;

background:rgba(0,0,0,.65);

z-index:99999;

}

.popup{

background:white;

width:90%;

max-width:420px;

margin:70px auto;

padding:30px;

border-radius:25px;

text-align:center;

animation:popup .5s;

}

@keyframes popup{

from{

opacity:0;

transform:translateY(-20px);

}

to{

opacity:1;

transform:translateY(0);

}

}

#closePopup{

float:right;

font-size:34px;

cursor:pointer;

color:#999;

}

#closePopup:hover{

color:#000;

}

/* ============================
ANIMASI BUNGA
============================ */

.flower{

position:fixed;

top:-30px;

pointer-events:none;

z-index:999;

animation:fall linear forwards;

}

@keyframes fall{

0%{

transform:translateY(-50px) rotate(0deg);

opacity:1;

}

100%{

transform:translateY(110vh) rotate(360deg);

opacity:0;

}

}

/* ============================
MUSIC BUTTON
============================ */

.musicButton{

position:fixed;

right:20px;

bottom:20px;

width:60px;

height:60px;

border:none;

border-radius:50%;

background:#688462;

color:white;

font-size:24px;

cursor:pointer;

box-shadow:0 8px 20px rgba(0,0,0,.25);

z-index:9999;

transition:.3s;

animation:pulse 2s infinite;

}

.musicButton:hover{

transform:scale(1.1);

}

@keyframes pulse{

0%{

box-shadow:0 0 0 0 rgba(181,139,45,.45);

}

70%{

box-shadow:0 0 0 18px rgba(181,139,45,0);

}

100%{

box-shadow:0 0 0 0 rgba(181,139,45,0);

}

}

/* ============================
SCROLL TO TOP
============================ */

.topButton{

display:none;

position:fixed;

right:20px;

bottom:95px;

width:50px;

height:50px;

border:none;

border-radius:50%;

background:#b58b2d;

color:white;

font-size:22px;

cursor:pointer;

z-index:9999;

transition:.3s;

}

.topButton:hover{

transform:translateY(-3px);

}

/* ============================
FOOTER
============================ */

footer{

padding:40px 20px;

background:#5d775f;

color:white;

text-align:center;

margin-top:60px;

}

footer p{

margin-top:10px;

font-size:15px;

opacity:.9;

}

/* ============================
RESPONSIVE
============================ */

@media(max-width:768px){

.overlay{

padding:30px;

}

.overlay h1{

font-size:34px;

}

.hero{

padding:70px 20px;

}

.hero h1{

font-size:32px;

}

.hero h2{

font-size:22px;

}

section{

padding:50px 15px;

}

section h2{

font-size:26px;

}

#countdown{

gap:12px;

}

#countdown div{

width:78px;

padding:16px;

}

#countdown span{

font-size:28px;

}

.card{

padding:20px;

}

.buttonGroup{

flex-direction:column;

align-items:center;

}

.btn{

width:90%;

justify-content:center;

}

.qr{

width:220px;

}

.musicButton{

width:55px;

height:55px;

font-size:22px;

}

.topButton{

width:45px;

height:45px;

}

}

